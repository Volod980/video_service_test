# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── fal.ai ────────────────────────────────────────────────────────────────────
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=...

# ── App config ────────────────────────────────────────────────────────────────
# Directory where temporary job files are stored (frames, clips, final video)
JOBS_DIR=/tmp/video_pipeline_jobs

# Set to "development" to enable uvicorn hot-reload
ENV=production

# Port (Railway injects $PORT automatically; override for local dev)
PORT=8000
